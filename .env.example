# =======================================================
# ProctorSentinel (ExamGuard) - Environment Configuration
# =======================================================

# Go Backend Server
PORT=8080
ENV=development
JWT_SECRET=super_secret_examguard_jwt_key_2026_change_in_production

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=examguard_admin
POSTGRES_PASSWORD=examguard_secret_2026
POSTGRES_DB=examguard_db

# Redis Cache & Pub/Sub
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage (Evidentiary Snapshots)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=examguard-snapshots

# Dashboard Frontend
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
